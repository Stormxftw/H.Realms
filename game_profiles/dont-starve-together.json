{
  "schemaVersion": "1.0",
  "id": "dont-starve-together",
  "name": "Don't Starve Together",
  "description": "DST dedicated server. SteamCMD AppID 343050 — anonymous login. Requires a cluster token from Klei at https://accounts.klei.com/account/game/servers.",
  "icon": "Flame",
  "controls": [
    {
      "id": "refresh",
      "kind": "button",
      "label": "Refresh status",
      "group": "Operations",
      "risk": "read-only",
      "variant": "outline",
      "binding": { "action": "ui.refresh" }
    },
    {
      "id": "start",
      "kind": "button",
      "label": "Start server",
      "group": "Operations",
      "risk": "service",
      "enabledWhen": "offline",
      "binding": { "action": "service.start" }
    },
    {
      "id": "stop",
      "kind": "button",
      "label": "Stop server",
      "group": "Operations",
      "risk": "disruptive",
      "enabledWhen": "online",
      "variant": "destructive",
      "help": "Stops the DST overworld and caves shards. Players will be kicked.",
      "binding": { "action": "service.stop" }
    },
    {
      "id": "restart",
      "kind": "button",
      "label": "Restart server",
      "group": "Operations",
      "risk": "disruptive",
      "enabledWhen": "online",
      "variant": "destructive",
      "binding": { "action": "service.restart" }
    }
  ]
}