{
  "schemaVersion": "1.0",
  "id": "sons-of-the-forest",
  "name": "Sons of the Forest",
  "description": "Sons of the Forest dedicated server. SteamCMD AppID 2465200 — anonymous login. Survival horror co-op. Config in dedicatedserver.cfg.",
  "icon": "Tree",
  "controls": [
    {
      "id": "refresh",
      "kind": "button",
      "label": "Refresh status",
      "group": "Operations",
      "risk": "read-only",
      "variant": "outline",
      "binding": { "action": "ui.refresh" }
    },
    {
      "id": "start",
      "kind": "button",
      "label": "Start server",
      "group": "Operations",
      "risk": "service",
      "enabledWhen": "offline",
      "binding": { "action": "service.start" }
    },
    {
      "id": "stop",
      "kind": "button",
      "label": "Stop server",
      "group": "Operations",
      "risk": "disruptive",
      "enabledWhen": "online",
      "variant": "destructive",
      "help": "Stops the Sons of the Forest server. Players will be disconnected.",
      "binding": { "action": "service.stop" }
    },
    {
      "id": "restart",
      "kind": "button",
      "label": "Restart server",
      "group": "Operations",
      "risk": "disruptive",
      "enabledWhen": "online",
      "variant": "destructive",
      "binding": { "action": "service.restart" }
    }
  ]
}