{
  "schemaVersion": "1.0",
  "id": "enshrouded",
  "name": "Enshrouded",
  "description": "Enshrouded dedicated server. SteamCMD AppID 2278520 — anonymous login. UE5-based, needs decent hardware. Server password and settings in enshrouded_server.json.",
  "icon": "Building",
  "controls": [
    {
      "id": "refresh",
      "kind": "button",
      "label": "Refresh status",
      "group": "Operations",
      "risk": "read-only",
      "variant": "outline",
      "binding": { "action": "ui.refresh" }
    },
    {
      "id": "start",
      "kind": "button",
      "label": "Start server",
      "group": "Operations",
      "risk": "service",
      "enabledWhen": "offline",
      "binding": { "action": "service.start" }
    },
    {
      "id": "stop",
      "kind": "button",
      "label": "Stop server",
      "group": "Operations",
      "risk": "disruptive",
      "enabledWhen": "online",
      "variant": "destructive",
      "help": "Stops the Enshrouded server. Players will be disconnected.",
      "binding": { "action": "service.stop" }
    },
    {
      "id": "restart",
      "kind": "button",
      "label": "Restart server",
      "group": "Operations",
      "risk": "disruptive",
      "enabledWhen": "online",
      "variant": "destructive",
      "binding": { "action": "service.restart" }
    }
  ]
}