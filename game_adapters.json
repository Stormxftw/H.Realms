            "start.sh",
            120
          ]
        ]
      },
      "propertyTypes": {},
      "statusCollector": "steam_query",
      "processSearch": "SonsOfTheForestDS",
      "defaultPort": 8766,
      "portProtocol": "udp",
      "queryPort": 8769,
      "additionalPorts": [
        {
          "name": "query",
          "port": 8769,
          "protocol": "udp"
        }
      ],
      "steamAppId": 2465200,
      "notes": "SteamCMD anonymous login supported. Query port is game port + 3."
    }
  }
}
