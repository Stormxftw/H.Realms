{
  "$schema": "./schemas/game-adapter-config.schema.json",
  "description": "Data-driven adapter mapping for Hermes Game Host Console. Each entry maps a game profile ID to its server scripts, process detection, and optional property types. Adding a new game = profile JSON + scripts + one entry here. No control_engine.py edits needed.",
  "games": {
    "minecraft": {
      "projectDir": "minecraft-server",
      "commands": {
        "service.start": [
          [
            "start.sh",
            60
          ]
        ],
        "service.stop": [
          [
            "stop.sh",
            120
          ]
        ],
        "service.restart": [
          [
            "stop.sh",
            120
          ],
          [
            "start.sh",
            60
          ]
        ],
        "backup.create": [
          [
            "backup.sh",
            300
          ]
        ]
      },
      "propertyTypes": {
        "difficulty": "string",
        "max-players": "integer",
        "white-list": "boolean",
        "view-distance": "integer",
        "motd": "string"
      },
      "statusCollector": "minecraft_ping",
      "processSearch": "server.jar nogui",
      "defaultPort": 25565,
      "portProtocol": "tcp",
      "requiredPaths": [
        {
          "path": "server.jar",
          "kind": "binary",
          "type": "file"
        },
        {
          "path": "server.properties",
          "kind": "config",
          "type": "file"
        },
        {
          "path": "world",
          "kind": "world",
          "type": "directory"
        }
      ]
    },
    "palworld": {
      "projectDir": "palworld-server-local",
      "commands": {
        "service.start": [
          [
            "scripts/palworld-linux-start.sh",
            60
          ]
        ],
        "service.stop": [
          [
            "scripts/palworld-linux-stop.sh",
            120
          ]
        ],
        "service.restart": [
          [
            "scripts/palworld-linux-stop.sh",
            120
          ],
          [
            "scripts/palworld-linux-start.sh",
            60
          ]
        ]
      },
      "propertyTypes": {},
      "statusCollector": "palworld_rest",
      "processSearch": "PalServer-Linux-Shipping",
      "defaultPort": 8211,
      "portProtocol": "udp",
      "restPort": 8212,
      "additionalPorts": [
        {
          "name": "query",
          "port": 27015,
          "protocol": "udp"
        }
      ],
      "requiredPaths": [
        {
          "path": "Pal/Binaries/Linux/PalServer-Linux-Shipping",
          "kind": "binary",
          "type": "file"
        },
        {
          "path": "Pal/Saved/Config/LinuxServer/PalWorldSettings.ini",
          "kind": "config",
          "type": "file"
        },
        {
          "path": "Pal/Saved/SaveGames",
          "kind": "save",
          "type": "directory"
        }
      ],
      "backup": {
        "projectDir": "/path/to/GameServers/PalworldServerLinux",
        "sourceDir": "Pal/Saved",
        "backupDir": "backups"
      }
    },
    "valheim": {
      "projectDir": "valheim-server",
      "commands": {
        "service.start": [
          [
            "start.sh",
            120
          ]
        ],
        "service.stop": [
          [
            "stop.sh",
            60
          ]
        ],
        "service.restart": [
          [
            "stop.sh",
            60
          ],
          [
            "start.sh",
            120
          ]
        ]
      },
      "propertyTypes": {},
      "statusCollector": "steam_query",
      "processSearch": "valheim_server.x86_64",
      "defaultPort": 2456,
      "portProtocol": "udp",
      "queryPort": 2457,
      "additionalPorts": [
        {
          "name": "query",
          "port": 2457,
          "protocol": "udp"
        }
      ],
      "steamAppId": 896660,
      "notes": "SteamCMD anonymous login supported. World name and password in start.sh."
    },
    "cs2": {
      "projectDir": "cs2-server",
      "commands": {
        "service.start": [
          [
            "start.sh",
            120
          ]
        ],
        "service.stop": [
          [
            "stop.sh",
            60
          ]
        ],
        "service.restart": [
          [
            "stop.sh",
            60
          ],
          [
            "start.sh",
            120
          ]
        ]
      },
      "propertyTypes": {},
      "statusCollector": "steam_query",
      "processSearch": "cs2",
      "defaultPort": 27015,
      "portProtocol": "udp",
      "steamAppId": 730,
      "notes": "SteamCMD requires game ownership token (GSLT). Create token at https://steamcommunity.com/dev/managegameservers."
    },
    "terraria": {
      "projectDir": "terraria-server",
      "commands": {
        "service.start": [
          [
            "start.sh",
            120
          ]
        ],
        "service.stop": [
          [
            "stop.sh",
            60
          ]
        ],
        "service.restart": [
          [
            "stop.sh",
            60
          ],
          [
            "start.sh",
            120
          ]
        ]
      },
      "propertyTypes": {},
      "statusCollector": "process_only",
      "processSearch": "TerrariaServer",
      "defaultPort": 7777,
      "portProtocol": "tcp",
      "notes": "Not on SteamCMD. Download from terraria.org or use the dedicated server tool in Steam library. World file (.wld) must be generated first."
    },
    "dont-starve-together": {
      "projectDir": "dst-server",
      "commands": {
        "service.start": [
          [
            "start.sh",
            180
          ]
        ],
        "service.stop": [
          [
            "stop.sh",
            60
          ]
        ],
        "service.restart": [
          [
            "stop.sh",
            60
          ],
          [
            "start.sh",
            180
          ]
        ]
      },
      "propertyTypes": {},
      "statusCollector": "process_only",
      "processSearch": "dontstarve_dedicated_server_nullrenderer",
      "defaultPort": 10999,
      "portProtocol": "udp",
      "steamAppId": 343050,
      "notes": "SteamCMD anonymous login supported. Requires cluster token from Klei at https://accounts.klei.com/account/game/servers."
    },
    "satisfactory": {
      "projectDir": "satisfactory-server",
      "commands": {
        "service.start": [
          [
            "start.sh",
            180
          ]
        ],
        "service.stop": [
          [
            "stop.sh",
            120
          ]
        ],
        "service.restart": [
          [
            "stop.sh",
            120
          ],
          [
            "start.sh",
            180
          ]
        ]
      },
      "propertyTypes": {},
      "statusCollector": "process_only",
      "processSearch": "FactoryServer.sh",
      "defaultPort": 7777,
      "portProtocol": "udp",
      "steamAppId": 1690800,
      "notes": "SteamCMD anonymous login supported. Large download (~12GB). Needs significant RAM."
    },
    "enshrouded": {
      "projectDir": "enshrouded-server",
      "commands": {
        "service.start": [
          [
            "start.sh",
            180
          ]
        ],
        "service.stop": [
          [
            "stop.sh",
            60
          ]
        ],
        "service.restart": [
          [
            "stop.sh",
            60
          ],
          [
            "start.sh",
            180
          ]
        ]
      },
      "propertyTypes": {},
      "statusCollector": "steam_query",
      "processSearch": "enshrouded_server",
      "defaultPort": 15636,
      "portProtocol": "udp",
      "queryPort": 15637,
      "additionalPorts": [
        {
          "name": "query",
          "port": 15637,
          "protocol": "udp"
        }
      ],
      "steamAppId": 2278520,
      "notes": "SteamCMD anonymous login supported. Uses UE5, needs decent hardware. Query port is game port + 1."
    },
    "sons-of-the-forest": {
      "projectDir": "sotf-server",
      "commands": {
        "service.start": [
          [
            "start.sh",
            120
          ]
        ],
        "service.stop": [
          [
            "stop.sh",
            60
          ]
        ],
        "service.restart": [
          [
            "stop.sh",
            60
          ],
