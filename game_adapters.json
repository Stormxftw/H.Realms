{
  "$schema": "./schemas/game-adapter-config.schema.json",
  "description": "Bundled Minecraft and Palworld adapter examples for Hermes Game Host Console. Machine-local server mappings belong in ignored data/local-game-adapters.json and can be generated with the bundled Hermes skill.",
  "games": {
    "minecraft": {
      "projectDir": "minecraft-server",
      "commands": {
        "service.start": [
          [
            "start.sh",
            60
          ]
        ],
        "service.stop": [
          [
            "stop.sh",
            120
          ]
        ],
        "service.restart": [
          [
            "stop.sh",
            120
          ],
          [
            "start.sh",
            60
          ]
        ],
        "backup.create": [
          [
            "backup.sh",
            300
          ]
        ]
      },
      "propertyTypes": {
        "difficulty": "string",
        "max-players": "integer",
        "white-list": "boolean",
        "view-distance": "integer",
        "motd": "string"
      },
      "statusCollector": "minecraft_ping",
      "processSearch": "server.jar nogui",
      "defaultPort": 25565,
      "portProtocol": "tcp",
      "requiredPaths": [
        {
          "path": "server.jar",
          "kind": "binary",
          "type": "file"
        },
        {
          "path": "server.properties",
          "kind": "config",
          "type": "file"
        },
        {
          "path": "world",
          "kind": "world",
          "type": "directory"
        }
      ]
    },
    "palworld": {
      "projectDir": "palworld-server-local",
      "commands": {
        "service.start": [
          [
            "scripts/palworld-linux-start.sh",
            60
          ]
        ],
        "service.stop": [
          [
            "scripts/palworld-linux-stop.sh",
            120
          ]
        ],
        "service.restart": [
          [
            "scripts/palworld-linux-stop.sh",
            120
          ],
          [
            "scripts/palworld-linux-start.sh",
            60
          ]
        ]
      },
      "propertyTypes": {},
      "statusCollector": "palworld_rest",
      "processSearch": "PalServer-Linux-Shipping",
      "defaultPort": 8211,
      "portProtocol": "udp",
      "restPort": 8212,
      "additionalPorts": [
        {
          "name": "query",
          "port": 27015,
          "protocol": "udp"
        }
      ],
      "requiredPaths": [
        {
          "path": "Pal/Binaries/Linux/PalServer-Linux-Shipping",
          "kind": "binary",
          "type": "file"
        },
        {
          "path": "Pal/Saved/Config/LinuxServer/PalWorldSettings.ini",
          "kind": "config",
          "type": "file"
        },
        {
          "path": "Pal/Saved/SaveGames",
          "kind": "save",
          "type": "directory"
        }
      ],
      "backup": {
        "projectDir": "palworld-server-local",
        "sourceDir": "Pal/Saved",
        "backupDir": "backups"
      }
    }
  }
}
