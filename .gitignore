/downloads/*.zip
/downloads/*.tar
/downloads/*.tar.gz
/downloads/*.tgz
/downloads/*.tar.xz
/downloads/*.7z

# Linked git worktrees checked out inside the repo tree (never commit)
/.worktrees/

# Stray test-generated sqlite db (not source)
/tests/operations.db

# Generated prompt-loop run logs
.promptloop/runs/
